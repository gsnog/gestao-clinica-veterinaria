meta {
  name: Login Tutor com CSRF
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/clinica/api/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "email": "tutor@exemplo.com",
    "senha": "senha123",
    "lembrar": false
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([200]).to.include(res.status);
  });
}
