meta {
  name: Criar Pet com CSRF
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/clinica/api/pets
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "nome": "QA Pet CSRF",
    "raca": "SRD",
    "dataNascimento": "2021-05-10",
    "tutorId": 1
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([201]).to.include(res.status);
  });
}
