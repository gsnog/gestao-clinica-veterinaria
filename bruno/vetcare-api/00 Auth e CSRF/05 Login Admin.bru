meta {
  name: Login Admin
  type: http
  seq: 5
}

post {
  url: http://localhost:8080/clinica/api/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "email": "admin@vetcare.com",
    "senha": "Admin@123",
    "lembrar": false
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([200]).to.include(res.status);
  });

  test("usuario com papel ADMIN", function() {
    expect(res.body.success).to.equal(true);
    expect(res.body.user.role).to.equal("ADMIN");
  });
}
