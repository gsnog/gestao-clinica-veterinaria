meta {
  name: Atualizar Usuario
  type: http
  seq: 3
}

put {
  url: http://localhost:8080/clinica/api/usuarios
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "id": {{usuarioQaId}},
    "nome": "Usuario QA Bruno Atualizado",
    "email": "qa.bruno@exemplo.com",
    "role": "TUTOR"
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([200]).to.include(res.status);
  });

  test("resposta em JSON", function() {
    expect(res.headers["content-type"]).to.contain("application/json");
  });
}
