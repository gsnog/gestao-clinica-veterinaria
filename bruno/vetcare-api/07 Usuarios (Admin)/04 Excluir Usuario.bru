meta {
  name: Excluir Usuario
  type: http
  seq: 4
}

delete {
  url: http://localhost:8080/clinica/api/usuarios/{{usuarioQaId}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

tests {
  test("status HTTP esperado", function() {
    expect([200]).to.include(res.status);
  });

  test("resposta de sucesso", function() {
    expect(res.body.success).to.equal(true);
  });
}
