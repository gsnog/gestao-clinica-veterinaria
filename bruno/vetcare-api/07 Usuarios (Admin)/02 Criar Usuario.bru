meta {
  name: Criar Usuario
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/clinica/api/usuarios
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "nome": "Usuario QA Bruno",
    "email": "qa.bruno@exemplo.com",
    "role": "TUTOR",
    "senha": "Senha@123"
  }
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("usuarioQaId", res.body.id);
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([201]).to.include(res.status);
  });

  test("resposta em JSON", function() {
    expect(res.headers["content-type"]).to.contain("application/json");
  });
}
