meta {
  name: Atualizar Tutor
  type: http
  seq: 2
}

put {
  url: http://localhost:8080/clinica/api/tutores
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-CSRF-Token: {{csrfToken}}
}

body:json {
  {
    "id": 1,
    "nome": "Tutor QA Bruno",
    "telefone": "(21) 98888-8888"
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([200]).to.include(res.status);
  });

  test("resposta em JSON", function() {
    expect(res.headers["content-type"]).to.contain("application/json");
  });
}
