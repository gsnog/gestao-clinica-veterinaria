meta {
  name: Atualizar Perfil
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/clinica/api/perfil
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "tutor@exemplo.com",
    "telefone": "(21) 99999-9999"
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([200]).to.include(res.status);
  });

  test("resposta em JSON", function() {
    expect(res.headers["content-type"]).to.contain("application/json");
  });
}
