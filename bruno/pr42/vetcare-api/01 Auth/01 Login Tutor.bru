meta {
  name: Login Tutor
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/clinica/api/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "tutor@exemplo.com",
    "senha": "senha123",
    "lembrar": false
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([200]).to.include(res.status);
  });

  test("resposta em JSON", function() {
    expect(res.headers["content-type"]).to.contain("application/json");
  });
}
