meta {
  name: Atualizar Consulta
  type: http
  seq: 3
}

put {
  url: http://localhost:8080/clinica/api/consultas
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "id": 1,
    "petId": 1,
    "veterinarioId": 2,
    "dataConsulta": "2026-06-21T14:00:00",
    "motivo": "Consulta QA Bruno Atualizada",
    "diagnostico": "Retorno agendado"
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([200]).to.include(res.status);
  });

  test("resposta em JSON", function() {
    expect(res.headers["content-type"]).to.contain("application/json");
  });
}
