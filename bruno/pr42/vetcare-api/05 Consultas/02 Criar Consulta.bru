meta {
  name: Criar Consulta
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/clinica/api/consultas
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "petId": 1,
    "veterinarioId": 2,
    "dataConsulta": "2026-06-20T10:30:00",
    "motivo": "Consulta QA Bruno",
    "diagnostico": "Paciente em acompanhamento"
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([201]).to.include(res.status);
  });

  test("resposta em JSON", function() {
    expect(res.headers["content-type"]).to.contain("application/json");
  });
}
