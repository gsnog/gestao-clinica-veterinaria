meta {
  name: Criar Pet
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/clinica/api/pets
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "nome": "QA Pet Bruno",
    "raca": "SRD",
    "dataNascimento": "2021-05-10",
    "tutorId": 1
  }
}

tests {
  test("status HTTP esperado", function() {
    expect([201]).to.include(res.status);
  });

  test("resposta em JSON", function() {
    expect(res.headers["content-type"]).to.contain("application/json");
  });
}
